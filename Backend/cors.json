[
  {
    "corsRuleName": "AllowReactViteUploads",
    "allowedOrigins": [
      "http://localhost:5173"
    ],
    "allowedOperations": [
      "s3_put",
      "s3_post",
      "s3_get",
      "s3_head",
      "b2_upload_file"
    ],
    "allowedHeaders": [
      "content-type",
      "x-amz-date",
      "x-amz-content-sha256",
      "authorization",
      "host",
      "*"
    ],
    "exposeHeaders": [
      "ETag"
    ],
    "maxAgeSeconds": 3600
  }
]
